# Cloud-Ready Configuration Template
# Copy this file to .env for local development
# For production, configure these as environment variables in your cloud platform

# Database Connection (REQUIRED)
# For AWS RDS SQL Server:
DATABASE_CONNECTION_STRING=Data Source=your-rds-endpoint.region.rds.amazonaws.com,1433;Initial Catalog=ToolHireDB;User ID=admin;Password=your-password;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Local Development Connection (Optional - fallback for local testing)
LOCALDB_CONNECTION_STRING=Data Source=(LocalDB)\\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\\Testing.mdf;Integrated Security=True;Connect Timeout=30;

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
APP_NAME=ToolHireSystem
APP_VERSION=1.0.0

# AWS-Specific Configuration (when deployed to AWS)
AWS_REGION=us-east-1
AWS_SECRET_NAME=toolhire/database/credentials
AWS_PARAMETER_STORE_PATH=/toolhire/config

# Logging Configuration
LOG_LEVEL=Information
ENABLE_STRUCTURED_LOGGING=true

# Security Settings
ENABLE_HTTPS=true
ALLOWED_HOSTS=*

# Notes for Cloud Deployment:
# 1. Never commit .env file with real credentials to source control
# 2. Use AWS Secrets Manager for production database credentials
# 3. Use AWS Systems Manager Parameter Store for non-sensitive configuration
# 4. Configure these as environment variables in ECS Task Definition or Lambda
# 5. Use IAM roles for AWS service access instead of access keys
